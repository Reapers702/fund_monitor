# ============ PostgreSQL（本应用库 fund_monitor） ============
# 连接 fund_monitor 库的凭证。aiFund（新闻只读库）字段留空自动继承以下凭证，仅 db 名不同（ai_fund）。
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_HOST=your_pg_host
PG_PORT=5432
PG_DB=fund_monitor

# ============ 识图（vision.js 视觉模型） ============
# 阿里云百炼 DashScope 兼容模式（vision.js 读取，用于 AGENTS.md 的识图能力）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可用模型示例：qwen3-vl-flash（低价） / qwen3.7-max-2026-06-08 等视觉模型
VISION_MODEL=qwen3-vl-flash

# ============ DeepSeek（AI 分析 / 建议） ============
# 用于 M6 AI 建议（--analyze / --analyze-all / 详情页"立即分析"）。
# 未配置时 AI 分析自动跳过；baseUrl 填 OpenAI 兼容端点（官方 https://api.deepseek.com 或中转站 /v1）。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
